{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "pnpm install --ignore-scripts",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build API Server",
      "type": "shell",
      "command": "pnpm run build",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/artifacts/api-server"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start Frontend (Dev)",
      "type": "shell",
      "command": "pnpm run dev",
      "group": "build",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/artifacts/herbora-ai",
        "env": {
          "PORT": "5173",
          "BASE_PATH": "/"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "devServers"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite",
          "endsPattern": "ready in"
        }
      }
    },
    {
      "label": "Start API Server (Dev)",
      "type": "shell",
      "command": "pnpm run dev",
      "group": "build",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/artifacts/api-server",
        "envFile": "${workspaceFolder}/.env"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "devServers"
      },
      "problemMatcher": []
    },
    {
      "label": "Typecheck All",
      "type": "shell",
      "command": "pnpm run typecheck",
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Start Full Dev (Frontend + API)",
      "dependsOn": [
        "Start Frontend (Dev)",
        "Start API Server (Dev)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
