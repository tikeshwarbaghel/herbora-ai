# =============================================================
# Herbora AI — Local Development Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================

# ── Server ────────────────────────────────────────────────────
# Port for the API server
PORT=3001

# ── Frontend (used by Vite) ───────────────────────────────────
# PORT and BASE_PATH must be set when running the Vite dev server.
# These are set inline in the VS Code tasks, but you can override here.
# PORT=5173
# BASE_PATH=/

# ── Database (PostgreSQL via Drizzle ORM) ─────────────────────
# Connection string for your local (or cloud) PostgreSQL instance.
# Example (local):  postgresql://postgres:password@localhost:5432/herbora_dev
# Example (Neon):   postgresql://user:pass@ep-xxx.neon.tech/herbora?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/herbora_dev

# ── Clerk Authentication ──────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
